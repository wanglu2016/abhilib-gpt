import AbhiLib.«分類»

namespace AbhiLib.«命題譯讀»

inductive «斷類» where | «見苦所斷» | «見集所斷» | «見滅所斷» | «見道所斷» | «修所斷» | «非所斷»

/-- 法取容許情形中的個例。人位固定一位有情及其當時的狀態。 -/
structure «詮釋» where
  «法» : Type
  «人位» : Type
  «四性判攝» : «法» → «四性»
  «所繫» : «法» → Option «三界»
  «生地» : «人位» → «三界»
  «所斷» : «法» → «斷類»
  «所屬根本靜慮» : «法» → Option «根本靜慮»
  «其餘等至» : «法» → Prop
  «有漏» : «法» → Prop
  «異熟果» : «法» → Prop
  «心不相應行» : «法» → Prop
  «得法標記» : «法» → Prop
  «業» : «法» → Prop
  «業道» : «法» → Prop
  «思» : «法» → Prop
  «色境界所攝» : «法» → Prop
  «色處所攝» : «法» → Prop
  «心» : «法» → Prop
  «學心標記» : «法» → Prop
  «無學心標記» : «法» → Prop
  «通果心標記» : «法» → Prop
  «苦根» : «法» → Prop
  «有身見» : «法» → Prop
  «邊執見» : «法» → Prop
  «慧» : «法» → Prop
  «無明» : «法» → Prop
  «無漏律儀標記» : «法» → Prop
  «靜慮律儀標記» : «法» → Prop
  «聖者» : «人位» → Prop
  «不還者» : «人位» → Prop
  «阿羅漢» : «人位» → Prop
  /-- 第一念在前，第二念為同一相續中容許的無間後念。 -/
  «無間生» : «法» → «法» → Prop
  «相應» : «法» → «法» → Prop
  «成就» : «人位» → «法» → Prop
  «現前» : «人位» → «法» → Prop
  «得» : «人位» → «法» → Prop
  «習修» : «人位» → «法» → Prop
  «得修» : «人位» → «法» → Prop

variable («釋» : «詮釋»)

/-- 十八界中色境一界的外延。三界.色界另有型別「三界」。 -/
def «十八界».«色界» := «釋».«色境界所攝»
def «十二處».«色處» := «釋».«色處所攝»
def «繫於» («界» : «三界») (x : «釋».«法») := «釋».«所繫» x = some «界»
def «生於» («界» : «三界») (s : «釋».«人位») := «釋».«生地» s = «界»
def «生上二界» (s : «釋».«人位») := «生於» «釋» «三界».«色界» s ∨ «生於» «釋» «三界».«無色界» s
def «有情» (_ : «釋».«人位») : Prop := True
def «屬性» («性» : «四性») (x : «釋».«法») := «釋».«四性判攝» x = «性»
def «無記» (x : «釋».«法») := «屬性» «釋» «四性».«有覆無記» x ∨ «屬性» «釋» «四性».«無覆無記» x
def «染污» (x : «釋».«法») := «屬性» «釋» «四性».«不善» x ∨ «屬性» «釋» «四性».«有覆無記» x
def «無漏» (x : «釋».«法») := ¬ «釋».«有漏» x
def «是等至» (x : «釋».«法») :=
  (∃ «地», «釋».«所屬根本靜慮» x = some «地») ∨ «釋».«其餘等至» x
def «等至».«淨» (x : «釋».«法») := «是等至» «釋» x ∧ «釋».«有漏» x ∧ «屬性» «釋» «四性».«善» x
def «屬根本靜慮» («地» : «根本靜慮») (x : «釋».«法») := «釋».«所屬根本靜慮» x = some «地»
def «屬斷類» («類» : «斷類») (x : «釋».«法») := «釋».«所斷» x = «類»
def «學心» (x : «釋».«法») := «釋».«學心標記» x ∧ «釋».«心» x ∧ «無漏» «釋» x
def «無學心» (x : «釋».«法») := «釋».«無學心標記» x ∧ «釋».«心» x ∧ «無漏» «釋» x
def «通果心» (x : «釋».«法») := «釋».«通果心標記» x ∧ «釋».«心» x ∧ «屬性» «釋» «四性».«無覆無記» x
def «無漏律儀» (x : «釋».«法») := «釋».«無漏律儀標記» x ∧ «無漏» «釋» x
def «靜慮律儀» (x : «釋».«法») := «釋».«靜慮律儀標記» x ∧ «釋».«有漏» x
/-- 《俱舍九題》第 36 頁的得法。 -/
def «心不相應行».«得» (x : «釋».«法») := «釋».«得法標記» x ∧ «釋».«心不相應行» x
def «得捨».«得» := «釋».«得»
def «二修».«習修» := «釋».«習修»
def «二修».«得修» := «釋».«得修»

end AbhiLib.«命題譯讀»

import AbhiLib
open AbhiLib AbhiLib.«分別實驗»

-- 若只知「是色」，缺少前提10的色業歸屬，第46步的推論就會失敗。
example : ∃ x : «色法», x.«種類» ≠ .«無表» ∧ «有覆無記色» x ∧ ¬ «表色» x :=
  ⟨⟨.«其餘»,.«有覆無記»,.«欲界»⟩, by decide⟩

-- 善表、不善表、無覆表都不會單憑「表」而自動取得有覆性。
example : ∃ x : «色法», «四規則皆成立» x ∧ «表色» x ∧ ¬ «有覆無記色» x :=
  ⟨⟨.«身表»,.«善»,.«欲界»⟩, by decide⟩

-- 初定有覆身表與語表各自滿足四條局部規則。
example : «四規則皆成立» ⟨.«身表»,.«有覆無記»,.«初靜慮»⟩ ∧ «四規則皆成立» ⟨.«語表»,.«有覆無記»,.«初靜慮»⟩ := by decide

-- 把毘婆沙師的表業範圍換成有餘師，三定有覆語表依然被排除。
example (x : «色法») (k : «染色屬業» x) (a : «無表有記» x) (o : «有餘師表業繫地» x) (d : «欲界無有覆表» x) (h : x.«繫屬» = .«第三靜慮») :
    ¬ «有覆無記色» x := fun c => «繫不繫».noConfusion (h.symm.trans («有餘師亦唯初定» x k a o d c))

-- 有餘師放寬的是無覆表；不善表同樣不在放寬範圍內。
example : ¬ «有餘師表業繫地» ⟨.«語表»,.«不善»,.«第三靜慮»⟩ := by decide

-- 無表排除無記性，單獨就能推出無表不是無覆無記。
example (x : «色法») (a : «無表有記» x) (h : x.«種類» = .«無表») : x.«四性判攝» ≠ .«無覆無記» :=
  fun n => a h (Or.inr n)

-- 得心計數排除欲善、欲無覆兩者時，只餘共同的五心。
example : («得心名單» false false).length = 5 := by decide

-- 即使計數相等，欲善仍可辨別這兩種六心讀法。
example : «容得» false true .«欲界善心» ≠ «容得» true false .«欲界善心» := by decide

-- 上一例的差異沒有波及有學與無學。
example : «容得» false true .«學心» = «容得» true false .«學心» ∧
    «容得» false true .«無學心» = «容得» true false .«無學心» := by decide

-- 「未全斷」還容許已新斷八品的純數值模型。
example : (8 : «已斷品數»).val < 9 ∧ (8 : «已斷品數»).val ≠ 0 := by decide
